{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "phrasePop",
  "version": "1.2.0-beta.1",
  "identifier": "com.vinzify.phrasepop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFNTNCQjgwMzlCNzQ5NzEKUldSeFNiYzVnTHRUTGlCOVdmeGpOcmoxOE5nSnkzdDJGNFZOdnBLb0VnSUhHbmZWalNWNlRYLysK",
      "endpoints": [
        "https://raw.githubusercontent.com/vinzify/PhrasePoP/main/preview.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "phrasePop",
        "width": 800,
        "height": 700,
        "minWidth": 640,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "visible": false,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
